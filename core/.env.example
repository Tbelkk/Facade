# Copy this file to core/.env and fill in your values. NEVER commit core/.env.
NVIDIA_API_KEY=nvapi-paste-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_VISION=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
MODEL_AGENT=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Tokens the model may spend "thinking". Lower = faster screen analysis. Try 512 / 1024 / 4096.
REASONING_BUDGET=1024
# Screenshots wider than this are scaled down before sending (faster, cheaper).
MAX_IMAGE_WIDTH=1600
NEMOTRON_TIMEOUT=90

# Filled in by teammates later
SPACETIME_HOST=https://maincloud.spacetimedb.com
SPACETIME_DB=facade
SPACETIME_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=
WS_PORT=8765
